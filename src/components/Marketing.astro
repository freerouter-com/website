---
import Brand from './Brand.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Icon from './Icon.astro';
import { Code } from 'astro/components';
interface Props { lang: 'zh' | 'en'; }
const { lang } = Astro.props;
const t = (zh: string, en: string) => lang === 'zh' ? zh : en;
const github = 'https://github.com/Neonity2020/free-router';
const samples = [
  { id: 'python', label: 'Python', lang: 'python' as const, filename: 'app.py', install: 'pip install openai', code: `import os\nfrom openai import OpenAI\n\nclient = OpenAI(\n    base_url="http://127.0.0.1:8787/v1",\n    api_key=os.environ["GATEWAY_API_KEY"],\n)\n\nresponse = client.chat.completions.create(\n    model="space-bunny",\n    messages=[{"role": "user", "content": "Hello!"}],\n)\n\nprint(response.choices[0].message.content)` },
  { id: 'curl', label: 'cURL', lang: 'bash' as const, filename: 'terminal', install: t('无需安装 SDK', 'No SDK required'), code: `curl http://127.0.0.1:8787/v1/chat/completions \\\n  -H 'Content-Type: application/json' \\\n  -H "Authorization: Bearer $GATEWAY_API_KEY" \\\n  -d '{\n    "model": "space-bunny",\n    "messages": [\n      {"role": "user", "content": "Hello!"}\n    ],\n    "stream": true\n  }'` },
  { id: 'node', label: 'Node.js', lang: 'javascript' as const, filename: 'app.mjs', install: 'npm install openai', code: `import OpenAI from "openai";\n\nconst client = new OpenAI({\n  baseURL: "http://127.0.0.1:8787/v1",\n  apiKey: process.env.GATEWAY_API_KEY,\n});\n\nconst response = await client.chat.completions.create({\n  model: "space-bunny",\n  messages: [{ role: "user", content: "Hello!" }],\n});\n\nconsole.log(response.choices[0].message.content);` },
];
const faqs = [
  { q: t('Free Router 是什么？', 'What is Free Router?'), a: t('Free Router 是运行在本机的 AI 网关。它将 OpenRouter、OpenCode Zen 和 Command Code 接到统一的 OpenAI-compatible 接口，并提供设置界面、Playground 和 Pi 编程代理。', 'Free Router is an AI gateway that runs on your machine. It connects OpenRouter, OpenCode Zen, and Command Code through one OpenAI-compatible API, with a settings UI, playground, and Pi coding agent.') },
  { q: t('“Free” 意味着模型调用完全免费吗？', 'Does “Free” mean all model calls are free?'), a: t('Free Router 的源码可在 GitHub 获取。模型是否免费、可用额度与访问条件由各上游决定，你需要配置自己的上游 API Key。它不承诺无限额度或所有模型免费。', 'The source is available on GitHub. Model pricing, quotas, and availability are determined by each upstream provider. You bring your own provider API keys; Free Router does not promise unlimited or universally free model access.') },
  { q: t('支持哪些 API 和模型？', 'Which APIs and models are supported?'), a: t('目前提供 Chat Completions 和模型列表，透传 SSE、工具调用及多模态参数。space-bunny 可自动路由，也可用上游前缀指定提供方。Command Code 支持其他 Chat Completions 模型 ID。当前没有 Responses 或 Anthropic Messages 协议转换。', 'It supports Chat Completions and model listing, with pass-through SSE, tool calls, and multimodal parameters. Use space-bunny for automatic routing or a provider prefix to select an upstream. Command Code also accepts other Chat Completions model IDs. Responses and Anthropic Messages conversion are not currently implemented.') },
  { q: t('我的 API Key 存在哪里？', 'Where are my API keys stored?'), a: t('上游密钥由本地 Rust 后端管理，保存在本地配置文件中，Unix 文件权限为 0600。前端不回显已保存的上游密钥，也不会把密钥持久化到浏览器存储。', 'Provider keys are managed by the local Rust backend and saved in local configuration files with Unix permissions of 0600. Saved provider keys are not returned to the UI or persisted in browser storage.') },
  { q: t('上游失败后会发生什么？', 'What happens if a provider fails?'), a: t('网关会尝试池中的其他可用 Key；自动路由还可以切换上游。失败的 Key 会按错误类型进入冷却。只有在响应头发送前才会重试，流式输出开始后不会重放请求，避免重复内容。', 'The gateway tries other available keys in the pool. Automatic routing can also switch providers. Failed keys enter cooldown based on the error. Retries happen before response headers are sent; a stream that has started is never replayed, avoiding duplicated output.') },
  { q: t('Pi Agent 能做什么？', 'What can Pi Agent do?'), a: t('Pi Agent 使用已有网关配置，在你指定的工作目录阅读代码、创建和编辑文件、执行命令与测试，也支持停止任务。工具以本机用户权限执行，工作目录不是安全沙箱，因此应在信任的本地环境中使用。', 'Pi Agent uses your existing gateway configuration to read code, create and edit files, and run commands and tests in a chosen directory. Tasks can be stopped. Tools run with your local user permissions; the working directory is not a sandbox, so use it in a trusted local environment.') },
];
---
<SiteHeader lang={lang} />
<main id="main">
  <section class="hero container">
    <div class="hero-copy">
      <a class="announcement" href={github} target="_blank" rel="noopener noreferrer"><span class="announcement-icon"><Icon name="code" size={13} /></span>{t('本地运行 · 开放源码 · 自由连接', 'Local first · Open source · Yours to build')}</a>
      <h1>{t('你的 AI，', 'Your AI.')}<br /><span>{t('自由连接。', 'Connected freely.')}</span></h1>
      <p class="hero-description">{t('一个入口，连接多个 AI 上游。', 'One endpoint. Multiple AI providers.')}<br />{t('把路由、密钥和故障切换交给 Free Router，', 'Let Free Router handle routing, keys, and failover. ')}<br class="desktop-break" />{t('把注意力留给你正在构建的东西。', 'Keep your focus on what you’re building.')}</p>
      <div class="hero-actions"><a class="button button-primary" href="#quickstart"><Icon name="terminal" size={19} />{t('开始使用', 'Get started')}</a><a class="button button-secondary" href={github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={19} />{t('查看源代码', 'View source')}</a></div>
      <div class="hero-meta"><span><Icon name="check" size={14} />{t('本地部署', 'Runs locally')}</span><span><Icon name="check" size={14} />OpenAI-compatible</span><span><Icon name="check" size={14} />{t('密钥由你掌控', 'Your keys, your control')}</span></div>
    </div>
    <div class="routing-visual" role="img" aria-label={t('你的应用通过 Free Router 自动路由到三个 AI 上游', 'Your app connects through Free Router to three AI providers')}>
      <div class="visual-topline"><span class="mono">ONE ENDPOINT. MORE POSSIBILITIES.</span><span class="visual-live">{t('路由示意', 'Routing diagram')}</span></div>
      <div class="routing-canvas">
        <svg class="route-lines" viewBox="0 0 540 400" preserveAspectRatio="none" aria-hidden="true"><path class="route-line base" d="M72 202H160M271 202H327Q342 202 342 187V108Q342 93 357 93H397M271 202H397M271 202H327Q342 202 342 217V296Q342 311 357 311H397" /><path class="route-line active" d="M72 202H160M271 202H397" /><circle class="flow-dot" r="3"><animateMotion dur="3.8s" repeatCount="indefinite" path="M72 202H397" /></circle></svg>
        <div class="app-node"><Icon name="terminal" size={24} /><span>{t('你的应用', 'Your app')}</span></div>
        <div class="router-node"><svg viewBox="0 0 32 32" width="43" height="43" fill="none" aria-hidden="true"><path d="M7 25V12a5 5 0 0 1 5-5h13M7 17h17M17 7v18m3-12 5 4-5 4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg><strong>free/router</strong><span>localhost:8787</span></div>
        <div class="provider-node provider-openrouter"><span class="provider-mark"><Icon name="route" size={19} /></span><span>OpenRouter<small>{t('多模型入口', 'Model gateway')}</small></span></div>
        <div class="provider-node provider-opencode selected"><span class="provider-mark"><Icon name="terminal" size={19} /></span><span>OpenCode Zen<small>{t('优先上游', 'Preferred provider')}</small></span><span class="selected-indicator" aria-hidden="true"></span></div>
        <div class="provider-node provider-commandcode"><span class="provider-mark"><Icon name="command" size={19} /></span><span>Command Code<small>Provider API</small></span></div>
        <span class="diagram-label request-label">/v1</span><span class="diagram-label route-label">{t('智能路由', 'Auto routing')}</span>
      </div>
      <div class="visual-bottomline"><span class="mono"><span class="code-purple">model</span>: <span>"space-bunny"</span></span><span><Icon name="shield" size={14} />{t('本地网关', 'Local gateway')}</span></div>
    </div>
  </section>
  <section class="provider-strip container" aria-label={t('支持的上游', 'Supported providers')}><span class="provider-strip-label">{t('不同的上游，同一个入口', 'Different providers. Same endpoint.')}</span><span><Icon name="route" size={23} />OpenRouter</span><span><Icon name="terminal" size={23} />opencode <b>zen</b></span><span><Icon name="command" size={23} />Command Code</span><span class="compatibility"><Icon name="code" size={20} />OpenAI API</span></section>
  <section id="features" class="features-section container section-space">
    <div class="section-heading"><div><span class="eyebrow">BUILT TO GET OUT OF YOUR WAY</span><h2>{t('连接更简单，', 'Less setup. ')}<br />{t('构建更专注。', 'More building.')}</h2></div><p>{t('从第一个请求，到下一次灵感。', 'From your first request to your next idea. ')}<br />{t('常用的能力，已经为你准备好。', 'The essentials are already here. ')}</p></div>
    <div class="feature-grid">
      <article class="feature-card feature-api"><div class="feature-icon"><Icon name="code" size={22} /></div><h3>{t('一个接口，不止一个选择', 'One API. More than one option.')}</h3><p>{t('复用熟悉的 OpenAI SDK。更换 baseURL，就能让现有应用接入本地网关。', 'Keep the OpenAI SDK you already know. Change the base URL to connect your existing app to your local gateway.')}</p><div class="endpoint-demo"><div><span class="mono">baseURL</span><span class="endpoint-value mono">127.0.0.1:8787/v1</span><span class="endpoint-tag">{t('统一入口', 'ONE ENDPOINT')}</span></div><div class="endpoint-models"><span class="mono">space-bunny</span><span class="mono">openrouter/…</span><span class="mono">commandcode/…</span></div></div></article>
      <article class="feature-card feature-keys"><div class="feature-icon"><Icon name="key" size={22} /></div><h3>{t('让每一把 Key 各尽其用', 'Put every key to work.')}</h3><p>{t('每个上游最多 16 个 Key，逐请求轮询。添加、删除、调整优先级，保存即生效。', 'Up to 16 keys per provider, rotated per request. Add keys, remove them, or change priorities without restarting.')}</p><div class="key-demo" aria-hidden="true"><span class="key-token"><Icon name="key" size={14} /><span class="mono">sk-•••• a1</span><span class="key-selected">{t('当前', 'active')}</span></span><span class="key-token"><Icon name="key" size={14} /><span class="mono">sk-•••• b2</span></span><span class="key-token"><Icon name="key" size={14} /><span class="mono">sk-•••• c3</span></span><span class="key-add">+13</span></div></article>
      <article class="feature-card feature-failover"><div class="feature-icon"><Icon name="route" size={22} /></div><h3>{t('遇到故障，换条路继续', 'A failed route isn’t the end.')}</h3><p>{t('失败 Key 自动冷却，可用 Key 继续接力。响应开始前切换上游，流式输出不重复。', 'Failed keys cool down while available keys take over. Switch providers before the response starts, without replaying a running stream.')}</p><div class="failover-demo"><span class="failover-stage"><span class="error-label mono">429</span><small>{t('上游限流', 'Rate limited')}</small></span><span class="failover-connector"></span><span class="failover-stage"><Icon name="route" size={22} /><small>{t('自动切换', 'Failover')}</small></span><span class="failover-connector active"></span><span class="failover-stage"><span class="success-label mono">200</span><small>{t('继续响应', 'Continue')}</small></span></div></article>
      <article class="feature-card feature-agent"><div class="feature-icon"><Icon name="terminal" size={22} /></div><h3>{t('不止调用，还能动手构建', 'Go from asking to building.')}</h3><p>{t('内置 Pi 编程代理。读代码、改文件、跑测试，直接使用你的网关配置。', 'A built-in Pi coding agent reads code, edits files, and runs tests, using the gateway you’ve already configured.')}</p><div class="agent-demo"><div><span class="agent-prompt">›</span><span class="mono">{t('给这个项目添加暗色主题', 'Add a dark theme to this project')}</span><span class="demo-tag">{t('示例', 'Example')}</span></div><div class="agent-tools"><span><Icon name="check" size={12} />read</span><span><Icon name="check" size={12} />edit</span><span><Icon name="check" size={12} />bash</span></div></div></article>
    </div>
    <div class="local-note"><Icon name="shield" size={20} /><p>{t('你的密钥，留在你的机器。', 'Your keys stay on your machine.')}<span>{t('本地 Rust 后端管理凭据，浏览器不持久化上游密钥。', 'Credentials are managed by the local Rust backend, never persisted in your browser.')}</span></p><span class="mono">LOCAL FIRST</span></div>
  </section>
  <section id="how-it-works" class="how-section">
    <div class="container"><div class="section-heading centered"><span class="eyebrow">A SMALL SETUP. A BETTER FLOW.</span><h2>{t('一次配置，随处调用。', 'Set up once. Connect everywhere.')}</h2><p>{t('从上游密钥到你的应用，只需要三步。', 'Three steps from provider keys to your app.')}</p></div><div class="steps-grid">
      <article class="step"><span class="step-number mono">01</span><h3>{t('启动本地网关', 'Start your local gateway')}</h3><p>{t('运行 Free Router 桌面应用，或从源码启动。默认在本机 8787 端口提供服务。', 'Run the desktop app or start from source. The default gateway listens locally on port 8787.')}</p><span class="step-footnote"><Icon name="terminal" size={16} />{t('桌面应用 / Web / CLI', 'Desktop / Web / CLI')}</span></article>
      <article class="step"><span class="step-number mono">02</span><h3>{t('连接你的上游', 'Connect your providers')}</h3><p>{t('在 Settings 填入上游 API Key，选择优先提供方，再生成统一的网关密钥。', 'Add provider API keys in Settings, choose your preferred provider, and generate a gateway key.')}</p><span class="step-footnote"><Icon name="key" size={16} />{t('带上你自己的 API Key', 'Bring your own API keys')}</span></article>
      <article class="step"><span class="step-number mono">03</span><h3>{t('开始构建', 'Build something')}</h3><p>{t('将 Base URL 和网关密钥填入应用，选择 space-bunny，让网关处理后续路由。', 'Set the base URL and gateway key in your app. Choose space-bunny and let the gateway handle routing.')}</p><span class="step-footnote"><Icon name="code" size={16} />{t('熟悉的 SDK，同样的调用方式', 'Same SDK. Familiar workflow.')}</span></article>
    </div></div>
  </section>
  <section id="quickstart" class="quickstart-section container section-space">
    <div class="quickstart-copy"><span class="eyebrow">HELLO, FREE ROUTER.</span><h2>{t('下一次调用，', 'Your next call. ')}<br />{t('从这里开始。', 'Starts here.')}</h2><p>{t('不需要学习另一套 API。', 'No new API to learn. ')}<br />{t('选择你熟悉的方式，发出第一个请求。', 'Pick your language and send your first request.')}</p><div class="quickstart-detail"><Icon name="key" size={18} /><span>{t('先在 Settings 中生成网关密钥，并设置 GATEWAY_API_KEY 环境变量。', 'Generate a gateway key in Settings and set the GATEWAY_API_KEY environment variable.')}</span></div><div class="quickstart-detail"><Icon name="globe" size={18} /><span>{t('桌面应用如自动更换端口，请使用应用内显示的 Base URL。', 'If the desktop app selects a different port, use the base URL shown in the app.')}</span></div><a class="text-link" href={github + '#启动'} target="_blank" rel="noopener noreferrer">{t('查看完整安装文档', 'Read the installation guide')}<Icon name="code" size={16} /></a></div>
    <div class="code-window"><div class="code-tabbar"><div role="tablist" aria-label={t('示例语言', 'Example language')}>{samples.map((sample, index) => <button role="tab" id={'tab-' + sample.id} aria-controls={'panel-' + sample.id} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-language={sample.id}>{sample.label}</button>)}</div><button class="copy-button" aria-label={t('复制当前代码', 'Copy current code')} data-copy-success={t('已复制', 'Copied')} data-copy-failure={t('请手动复制', 'Copy manually')}><Icon name="copy" size={14} /><span>{t('复制', 'Copy')}</span></button></div>{samples.map((sample,index) => <div class="code-panel" role="tabpanel" id={'panel-' + sample.id} aria-labelledby={'tab-' + sample.id} tabindex="0" hidden={index !== 0}><div class="code-filename mono"><span>{sample.filename}</span><span>{sample.install}</span></div><Code code={sample.code} lang={sample.lang} theme="github-dark" /></div>)}<div class="code-status"><span><Icon name="code" size={14} />OpenAI-compatible API</span><span class="mono">/v1/chat/completions</span></div><span class="sr-only copy-status" role="status" aria-live="polite"></span></div>
  </section>
  <section class="faq-section container"><div class="faq-heading"><span class="eyebrow">GOOD QUESTIONS.</span><h2>{t('你可能想知道。', 'A few things to know.')}</h2><p>{t('关于接口、密钥，以及你的下一步。', 'About the API, your keys, and what’s next.')}</p><a class="text-link" href={github + '/issues'} target="_blank" rel="noopener noreferrer"><Icon name="github" size={17} />{t('在 GitHub 继续交流', 'Join the conversation on GitHub')}</a></div><div class="faq-list">{faqs.map((faq) => <details><summary>{faq.q}<Icon name="chevron" size={18} /></summary><p>{faq.a}</p></details>)}</div></section>
  <section class="closing-section container"><div class="closing-brand" aria-hidden="true"><Brand light /></div><span class="eyebrow">LESS FRICTION. MORE FREEDOM.</span><h2>{t('让好想法，自由发生。', 'Give your ideas room to run.')}</h2><p>{t('从一个本地网关开始，连接你的下一次创造。', 'One local gateway. Whatever you want to build next.')}</p><a class="button button-white" href={github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={19} />{t('在 GitHub 开始', 'Start on GitHub')}</a><span class="closing-meta">{t('开放源码 · 本地运行 · 自由构建', 'Open source · Local first · Free to build')}</span></section>
</main>
<SiteFooter lang={lang} />
<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const activateTab = (selected: HTMLButtonElement) => {
    tabs.forEach((tab) => {
      const active = tab === selected;
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
      const panel = document.getElementById(tab.getAttribute('aria-controls') || '');
      if (panel) panel.hidden = !active;
    });
  };
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activateTab(tab));
    tab.addEventListener('keydown', (event) => {
      let nextIndex: number;
      if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') nextIndex = 0;
      else if (event.key === 'End') nextIndex = tabs.length - 1;
      else return;
      event.preventDefault();
      activateTab(tabs[nextIndex]);
      tabs[nextIndex].focus();
    });
  });
  const copyButton = document.querySelector<HTMLButtonElement>('.copy-button');
  let copyResetTimer: ReturnType<typeof setTimeout> | undefined;
  copyButton?.addEventListener('click', async () => {
    const code = document.querySelector<HTMLElement>('.code-panel:not([hidden]) code');
    const label = copyButton.querySelector('span');
    if (!code || !label) return;
    try {
      await navigator.clipboard.writeText(code.textContent || '');
      label.textContent = copyButton.dataset.copySuccess || 'Copied';
    } catch {
      const range = document.createRange();
      range.selectNodeContents(code);
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
      label.textContent = copyButton.dataset.copyFailure || 'Copy manually';
    }
    const status = document.querySelector('.copy-status');
    if (status) status.textContent = label.textContent;
    clearTimeout(copyResetTimer);
    copyResetTimer = setTimeout(() => {
      label.textContent = document.documentElement.lang === 'zh-CN' ? '复制' : 'Copy';
      if (status) status.textContent = '';
    }, 2400);
  });
</script>
