---
import BlogLayout from './BlogLayout.astro';
import Icon from '../components/Icon.astro';
import { render } from 'astro:content';
import {
  blogPath,
  formatDate,
  otherLanguage,
  postPath,
  readingTime,
  type Lang,
  type Post,
} from '../lib/blog';

interface Props { lang: Lang; post: Post; translation?: Post; }
const { lang, post, translation } = Astro.props;
const t = (zh: string, en: string) => lang === 'zh' ? zh : en;
const { Content } = await render(post);
const minutes = readingTime(post.body, lang);
const switchLang = translation ? postPath(translation) : blogPath(otherLanguage(lang));
// Each language points at this post's own translation, falling back to that
// language's blog index when a translation has not been written yet.
const languagePath = (target: Lang) =>
  post.lang === target ? postPath(post) : translation ? postPath(translation) : blogPath(target);
const alternates = { zh: languagePath('zh'), en: languagePath('en') };
---
<BlogLayout
  lang={lang}
  title={`${post.data.title} — Free Router`}
  description={post.data.description}
  ogType="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  languageHref={switchLang}
  alternates={alternates}
>
  <main id="main">
    <article class="post-article container">
      <a class="back-link" href={blogPath(lang)}><Icon name="arrowLeft" size={15} />{t('返回博客', 'Back to the blog')}</a>
      <header class="post-header">
        <div class="post-meta">
          <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, lang)}</time>
          <span aria-hidden="true">·</span>
          <span>{minutes} {t('分钟阅读', 'min read')}</span>
          {post.data.tags.length > 0 && <span aria-hidden="true">·</span>}
          {post.data.tags.map((tag) => <span class="post-tag">{tag}</span>)}
        </div>
        <h1>{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>
      </header>
      <div class="prose"><Content /></div>
      <footer class="post-footer">
        <a class="text-link" href={switchLang}>
          <Icon name="globe" size={16} />
          {translation ? translation.data.title : t('English version', '中文版')}
        </a>
      </footer>
    </article>
  </main>
</BlogLayout>